# 工作台 V0.2 环境变量示例
# 复制为 .env 后按需修改；不配置时使用默认值，可直接本地运行

# 服务端口
WORKBENCH_PORT=8088

# SQLite 数据库文件位置（本地试点零外部依赖；生产应切换 PostgreSQL）
DATABASE_URL=sqlite:///./data/workbench.db

# 上传文件大小上限（MB）
MAX_UPLOAD_MB=20

# 表头识别引擎：rule=规则词典（当前唯一实现）；llm=预留，当前不可用
RECOGNIZER_ENGINE=rule
# 独立子系统部署后填写入口。未填写时，平台只展示模块状态，不会伪造链接。
PROBLEM_HUB_URL=
PM_PLATFORM_URL=
