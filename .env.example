# Local development defaults. Do not use these settings as a production deployment.
APP_ENV=development
WORKBENCH_HOST=127.0.0.1
WORKBENCH_PORT=8088
LOG_LEVEL=INFO

# Local SQLite. Production compose overrides this with PostgreSQL.
DATABASE_URL=sqlite:///./data/workbench.db
DATA_DIR=./data
UPLOAD_DIR=./data/uploads
MAX_UPLOAD_MB=20
MAX_PREVIEW_ROWS=500
MAX_XLSX_SHEETS=40
MAX_XLSX_COLUMNS=200
MAX_XLSX_ZIP_ENTRIES=2000
MAX_XLSX_UNCOMPRESSED_MB=100
MAX_XLSX_COMPRESSION_RATIO=250
UPLOAD_RETENTION_DAYS=30

# Development only. In production AUTH_MODE must be proxy and trusted ingress is required.
AUTH_MODE=disabled
AUTH_PROXY_TRUSTED=false
AUTH_USER_HEADER=X-Auth-Request-User
AUTH_EMAIL_HEADER=X-Auth-Request-Email
AUTH_GROUPS_HEADER=X-Auth-Request-Groups
AUTH_ADMIN_GROUPS=
AUTH_QUALITY_GROUPS=
AUTH_PM_GROUPS=
AUTH_ENGINEERING_GROUPS=
AUTH_VIEWER_GROUPS=

# External integration placeholders. Endpoint values alone do not mean an adapter is implemented.
PROBLEM_HUB_URL=
PM_PLATFORM_URL=
QMS_API_BASE_URL=
PLM_API_BASE_URL=
MODEL_GATEWAY_URL=
MODEL_NAME=
MODEL_API_KEY=
RECOGNIZER_ENGINE=rule
REQUEST_TIMEOUT_SECONDS=15
METRICS_ENABLED=false

# Production identity-provider placeholders (fill in a secret manager; never commit real secrets).
OIDC_ISSUER_URL=https://idp.example.invalid/replace-me
OIDC_CLIENT_ID=__SET_ME__
OIDC_CLIENT_SECRET=__SET_ME__
OAUTH2_PROXY_COOKIE_SECRET=__SET_ME__
AUTH_ADMIN_GROUPS=__SET_ME__
AUTH_QUALITY_GROUPS=__SET_ME__
AUTH_PM_GROUPS=__SET_ME__
AUTH_ENGINEERING_GROUPS=__SET_ME__
AUTH_VIEWER_GROUPS=__SET_ME__
SERVER_NAME=workbench.example.invalid
